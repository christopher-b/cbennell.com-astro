---
import { render } from 'astro:content';
import { getCoverImage } from '@lib/images';
import { getPublishedLabs } from '@lib/lab.ts';

import DefaultLayout from '@layouts/Default.astro';
import HeroImage from '@components/HeroImage.astro';

export async function getStaticPaths() {
  const posts = await getPublishedLabs();
	return posts.filter((post) => !post.data.link).map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const lab = Astro.props;
const { Content } = await render(lab);
const { title, description, heroImage } = lab.data;
const coverImage = await getCoverImage(heroImage, title);
---

<DefaultLayout
  title={title}
  description={description ?? ''}
  image={coverImage}
>
  <article class="post">
    <header>
      <h1><a href="/lab">Lab</a> / {title}</h1>
      <HeroImage image={coverImage} />
    </header>
    <Content />
  </article>
</DefaultLayout>

