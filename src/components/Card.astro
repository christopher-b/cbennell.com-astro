---
import type { CollectionEntry } from 'astro:content';
import { getEntryUrl } from '@lib/util';
import PostMeta from '@components/PostMeta.astro';

interface Props {
  post: CollectionEntry<'posts'>|CollectionEntry<'lab'>;
}

const { post } = Astro.props;
const url = getEntryUrl(post);
---

<article class="post card" aria-labelledby={`post-header-${post.id}`}>
	<PostMeta post={post} />
  <h2 id={`post-header-${post.id}`}>
		<a href={url}>
			{post.data.title}
    </a>
  </h2>

  <excerpt>{post.data.description}</excerpt>
</article>
