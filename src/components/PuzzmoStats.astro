<section class="puzzmo-container" aria-live="polite" aria-busy="true" data-puzzmo-container aria-labelledby="puzzle-stats-heading">
  <h2 id="puzzle-stats-heading" class="sr-only">My Puzzmo Stats</h2>
  <p data-puzzmo-status>Loading Puzzmo stats...</p>
  <ul class="puzzmo-stats" data-puzzmo-stats></ul>
</section>

<template data-puzzmo-template>
  <li>
    <header>
      <h2>
        <img alt="Game logo" />
      </h2>
      <p class="last-played">
        Last game
        <time data-updated></time>
      </p>
    </header>
    <dl>
      <div>
        <dt>Streak</dt>
        <dd data-current></dd>
      </div>
      <div>
        <dt>Highest Streak</dt>
        <dd data-max></dd>
      </div>
      <div>
        <dt>Games Played</dt>
        <dd data-total></dd>
      </div>
    </dl>
  </li>
</template>


<script>
  import { colorScheme } from "@lib/util.ts"
  import { getAtprotoRecordKey, listRecordsForHandle, type AtprotoRecord } from '@lib/atproto';

  type PuzzmoStreakRecord = AtprotoRecord & {
    current?: number;
    gameDisplayName?: string;
    gameSlug?: string;
    lastUpdated?: string;
    max?: number;
    syncedAt?: string;
    teamSlug?: string;
    total?: number;
  };

  const handle = 'cbennell.com';
  const collection = 'com.puzzmo.streak';
  const recordLimit = 50;
  const stats = document.querySelector('[data-puzzmo-container]');
  const status = document.querySelector<HTMLParagraphElement>('[data-puzzmo-status]');
  const list = document.querySelector('[data-puzzmo-stats]');
  const template = document.querySelector<HTMLTemplateElement>('[data-puzzmo-template]');

  const formatDate = (date: string) => {
    return new Date(date).toLocaleDateString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  };

  const formatNumber = (value: number | undefined) => {
    return value?.toLocaleString('en-GB') ?? '0';
  };

  const loadStats = async () => {
    if (!status || !stats || !list || !template) {
      return;
    }

    try {
      const { records } = await listRecordsForHandle<PuzzmoStreakRecord>({
        collection,
        handle,
        limit: recordLimit,
      });
      const streaks = records
        .filter(({ value }) => value.teamSlug === 'puzzmo' && value.gameSlug)
        .sort((a, b) => {
          return (b.value.current ?? 0) - (a.value.current ?? 0)
            || (b.value.total ?? 0) - (a.value.total ?? 0)
            || (b.value.max ?? 0) - (a.value.max ?? 0)
            || getAtprotoRecordKey(a.uri).localeCompare(getAtprotoRecordKey(b.uri));
        });

      stats.setAttribute('aria-busy', 'false');
      status.hidden = streaks.length > 0;
      status.textContent = streaks.length ? '' : 'No Puzzmo streak records found.';

      for (const { uri, value } of streaks) {
        const clone = template.content.cloneNode(true) as DocumentFragment;
        const title = clone.querySelector('h2')!;
        const img = clone.querySelector('img')!;
        const current = clone.querySelector('[data-current]')!;
        const max = clone.querySelector('[data-max]')!;
        const total = clone.querySelector('[data-total]')!;
        const updated = clone.querySelector<HTMLTimeElement>('[data-updated]')!;
        const updatedAt = value.lastUpdated ?? value.syncedAt ?? '';

        title.append(value.gameDisplayName ?? getAtprotoRecordKey(uri));

        let fg, bg = null;
        const dark = "395042";
        const light = "abf0c5";
        if(colorScheme() === "dark") {
          fg = light;
          bg = dark;
        }
        else {
          fg = dark;
          bg = light;
        }
        img.src = `https://api.puzzmo.com/gameIcon?slug=${value.gameSlug}&fg=${fg}&bg=${bg}&size=28`
        current.textContent = formatNumber(value.current);
        max.textContent = formatNumber(value.max);
        total.textContent = formatNumber(value.total);
        updated.dateTime = updatedAt;
        updated.textContent = updatedAt ? formatDate(updatedAt) : 'Unknown';

        list.append(clone);
      }
    }
    catch (error) {
      stats.setAttribute('aria-busy', 'false');
      status.textContent = error instanceof Error ? error.message : 'Could not load Puzzmo stats.';
    }
  };

  loadStats();
</script>

<style>
  .puzzmo-stats {
    list-style: none;
    padding: 0;
  }

  .puzzmo-stats h2 {
    margin-block-start: 0;
  }

  .puzzmo-stats header {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--s0);
    align-items: center;
  }

  .last-played {
    font-size: var(--font-xs);
    text-align: right;
    color: var(--text-color-muted);
    margin: 0;
  }

  .puzzmo-stats li:not(:last-child) {
    border-bottom: thin solid var(--color-border);
    padding-bottom: var(--s0);
    margin-bottom: var(--s0);
  }

  .puzzmo-stats h2 img {
    display: inline;
  }

  .puzzmo-stats dl {
    display: flex;
    justify-content: space-between;
  }

  .puzzmo-stats dl div {
    display: flex;
    flex-direction: column-reverse;
    text-align: center;
  }

  .puzzmo-stats dt {
    color: var(--text-color-muted);
  }

  .puzzmo-stats dd {
    font-size: var(--font-xl);
    font-family: var(--font-display);
    line-height: 0.9;
  }
</style>
