---
import { Image } from 'astro:assets';
import type { CoverImage } from '@lib/images';

interface Props {
  image: CoverImage | undefined;
}

const { image } = Astro.props;
---

{image && (
  <picture class="feature">
    <Image src={image.src} alt={image.alt} loading="eager" fetchpriority="high"/>
  </picture>
)}
